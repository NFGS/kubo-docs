{
  "openapi": "3.1.0",
  "info": {
    "title": "Kubo API",
    "version": "0.2.0",
    "description": "Contrato del API Gateway de Kubo. Los esquemas de components.schemas se validan contra las respuestas reales con `make contracts` (kubo-gateway/scripts/contracts.mjs)."
  },
  "servers": [
    { "url": "http://localhost:9080/api/v1", "description": "Gateway local" }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Inicia sesion",
        "responses": {
          "200": {
            "description": "Sesion creada. El refresh token viaja en cookie httpOnly, no en el cuerpo.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "Credenciales invalidas o cuenta bloqueada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Perfil del usuario autenticado",
        "responses": {
          "200": {
            "description": "Perfil",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Catalogo paginado",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "low_stock", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 200 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Pagina del catalogo con el total real",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductList" }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Detalle de producto",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Producto",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductItem" }
              }
            }
          }
        }
      }
    },
    "/customers": {
      "get": {
        "summary": "Clientes (documento y telefono enmascarados)",
        "responses": {
          "200": {
            "description": "Listado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CustomerList" }
              }
            }
          }
        }
      }
    },
    "/sales": {
      "get": {
        "summary": "Ventas paginadas",
        "responses": {
          "200": {
            "description": "Pagina de ventas con el total real",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SaleList" }
              }
            }
          }
        }
      }
    },
    "/suppliers": {
      "get": {
        "summary": "Proveedores paginados",
        "responses": {
          "200": {
            "description": "Pagina de proveedores con el total real",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupplierList" }
              }
            }
          }
        }
      }
    },
    "/purchases": {
      "get": {
        "summary": "Compras paginadas",
        "responses": {
          "200": {
            "description": "Pagina de compras con el total real",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PurchaseList" }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Usuarios del negocio (paginado)",
        "responses": {
          "200": {
            "description": "Pagina de usuarios",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsersPage" }
              }
            }
          }
        }
      }
    },
    "/cash-sessions/current": {
      "get": {
        "summary": "Sesion de caja abierta con su arqueo (o null)",
        "responses": {
          "200": {
            "description": "Turno abierto, con el esperado en caja, o data null si no hay caja abierta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CashSessionCurrent" }
              }
            }
          }
        }
      }
    },
    "/dashboard/overview": {
      "get": {
        "summary": "Vista compuesta del tablero (BFF)",
        "responses": {
          "200": {
            "description": "Vistas del tablero en una sola respuesta",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OverviewResponse" }
              }
            }
          }
        }
      }
    },
    "/reports/sales.csv": {
      "get": {
        "summary": "Reporte de ventas en CSV",
        "description": "Filtro opcional `from`/`to` (YYYY-MM-DD) interpretado en la zona horaria del negocio. Una fecha invalida responde 400 con code INVALID_DATE_RANGE.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Ventas en CSV (numero, fecha, cliente, medio_pago, estado, subtotal, impuesto, total)",
            "content": {
              "text/csv": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": {
            "description": "Rango de fechas invalido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/reports/inventory.csv": {
      "get": {
        "summary": "Inventario valorizado en CSV",
        "responses": {
          "200": {
            "description": "Inventario en CSV (sku, nombre, stock, stock_minimo, costo, precio, valor_inventario)",
            "content": {
              "text/csv": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/packs": {
      "get": {
        "summary": "Paquetes de configuracion por vertical (P-17)",
        "responses": {
          "200": {
            "description": "Catalogo de paquetes que el ERP sabe aplicar",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PackList" }
              }
            }
          }
        }
      }
    },
    "/packs/current": {
      "get": {
        "summary": "Paquete activo del negocio",
        "description": "El vertical llega en el token y el gateway lo propaga como x-tenant-vertical; un vertical desconocido cae al paquete por defecto.",
        "responses": {
          "200": {
            "description": "Paquete activo (retail por defecto)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PackItem" }
              }
            }
          }
        }
      }
    },
    "/packs/apply": {
      "post": {
        "summary": "Siembra el catalogo de arranque del paquete activo (idempotente)",
        "description": "Crea los productos de arranque del vertical; los SKU que ya existen se omiten.",
        "responses": {
          "200": {
            "description": "Resumen de la siembra",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["created", "skipped", "pack"],
                      "properties": {
                        "created": { "type": "integer", "minimum": 0 },
                        "skipped": { "type": "integer", "minimum": 0 },
                        "pack": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tenants/me": {
      "get": {
        "summary": "Perfil del negocio (zona horaria y vertical)",
        "responses": {
          "200": {
            "description": "Perfil del negocio del actor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TenantItem" }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Cambia la zona horaria y/o el vertical. Solo propietario o administrador",
        "description": "Los valores viajan en el token: aplican al siguiente refresco de sesion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTenantRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TenantItem" }
              }
            }
          },
          "400": {
            "description": "Zona horaria o vertical invalidos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pack": {
        "type": "object",
        "required": [
          "key",
          "name",
          "description",
          "product_label",
          "product_label_plural",
          "default_tax_rate",
          "tracks_stock",
          "pos_flow"
        ],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "product_label": { "type": "string" },
          "product_label_plural": { "type": "string" },
          "default_tax_rate": { "type": "string" },
          "tracks_stock": { "type": "boolean" },
          "pos_flow": { "type": "string" }
        }
      },
      "Tenant": {
        "type": "object",
        "required": ["id", "name", "slug", "plan", "timezone", "vertical"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "plan": { "type": "string" },
          "timezone": { "type": "string" },
          "vertical": { "type": "string" }
        }
      },
      "UpdateTenantRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timezone": { "type": "string" },
          "vertical": { "type": "string", "enum": ["retail", "servicios", "restaurantes", "agro"] }
        }
      },
      "PackList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Pack" } }
        }
      },
      "PackItem": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Pack" } }
      },
      "TenantItem": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Tenant" } }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "fullName", "role", "tenantId", "tenantName"],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "fullName": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": ["string", "null"] },
          "tenantId": { "type": "string" },
          "tenantName": { "type": "string" }
        }
      },
      "UsersPage": {
        "type": "object",
        "required": ["content", "totalElements"],
        "properties": {
          "content": { "type": "array", "items": { "$ref": "#/components/schemas/User" } },
          "totalElements": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer" },
          "size": { "type": "integer" },
          "number": { "type": "integer" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accessToken", "tokenType", "expiresInSeconds", "user"],
        "properties": {
          "accessToken": { "type": "string", "minLength": 20 },
          "tokenType": { "const": "Bearer" },
          "expiresInSeconds": { "type": "integer", "minimum": 60 },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id", "sku", "name", "unit", "price", "cost", "tax_rate",
          "stock", "min_stock", "low_stock", "active", "created_at", "updated_at"
        ],
        "properties": {
          "id": { "type": "string" },
          "sku": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "price": { "type": "string" },
          "cost": { "type": "string" },
          "tax_rate": { "type": "string" },
          "stock": { "type": "integer" },
          "min_stock": { "type": "integer" },
          "low_stock": { "type": "boolean" },
          "active": { "type": "boolean" },
          "created_at": { "type": ["string", "null"] },
          "updated_at": { "type": ["string", "null"] }
        }
      },
      "ProductList": {
        "type": "object",
        "required": ["data", "total", "limit", "offset"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "ProductItem": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Product" }
        }
      },
      "Customer": {
        "type": "object",
        "required": ["id", "name", "stage", "credit_limit", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "document_number": { "type": ["string", "null"] },
          "phone": { "type": ["string", "null"] },
          "city": { "type": ["string", "null"] },
          "address": { "type": ["string", "null"] },
          "stage": { "enum": ["LEAD", "PROSPECT", "CUSTOMER"] },
          "notes": { "type": ["string", "null"] },
          "credit_limit": { "type": "number" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "CustomerList": {
        "type": "object",
        "required": ["data", "total"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Customer" } },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "SaleItem": {
        "type": "object",
        "required": ["id", "product_id", "product_name", "quantity", "unit_price", "tax_rate", "tax_amount", "total"],
        "properties": {
          "id": { "type": "string" },
          "product_id": { "type": "string" },
          "product_name": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit_price": { "type": "string" },
          "tax_rate": { "type": "string" },
          "tax_amount": { "type": "string" },
          "total": { "type": "string" }
        }
      },
      "Sale": {
        "type": "object",
        "required": ["id", "number", "status", "payment_method", "subtotal", "tax", "total", "items"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "string" },
          "status": { "enum": ["COMPLETED", "VOIDED"] },
          "customer_id": { "type": ["string", "null"] },
          "customer_name": { "type": ["string", "null"] },
          "payment_method": { "type": "string" },
          "subtotal": { "type": "string" },
          "tax": { "type": "string" },
          "total": { "type": "string" },
          "notes": { "type": ["string", "null"] },
          "sold_by": { "type": ["string", "null"] },
          "voided_at": { "type": ["string", "null"] },
          "created_at": { "type": ["string", "null"] },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/SaleItem" } }
        }
      },
      "SaleList": {
        "type": "object",
        "required": ["data", "total", "limit", "offset"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Sale" } },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "Supplier": {
        "type": "object",
        "required": ["id", "name", "active", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tax_id": { "type": ["string", "null"] },
          "contact_name": { "type": ["string", "null"] },
          "phone": { "type": ["string", "null"] },
          "email": { "type": ["string", "null"] },
          "address": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "active": { "type": "boolean" },
          "created_at": { "type": ["string", "null"] },
          "updated_at": { "type": ["string", "null"] }
        }
      },
      "SupplierList": {
        "type": "object",
        "required": ["data", "total", "limit", "offset"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Supplier" } },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "PurchaseItem": {
        "type": "object",
        "required": ["id", "product_id", "product_name", "quantity", "unit_cost", "tax_rate", "tax_amount", "total"],
        "properties": {
          "id": { "type": "string" },
          "product_id": { "type": "string" },
          "product_name": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit_cost": { "type": "string" },
          "tax_rate": { "type": "string" },
          "tax_amount": { "type": "string" },
          "total": { "type": "string" }
        }
      },
      "Purchase": {
        "type": "object",
        "required": ["id", "number", "status", "supplier_id", "supplier_name", "subtotal", "tax", "total", "items"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "string" },
          "status": { "enum": ["RECEIVED", "VOIDED"] },
          "supplier_id": { "type": "string" },
          "supplier_name": { "type": "string" },
          "subtotal": { "type": "string" },
          "tax": { "type": "string" },
          "total": { "type": "string" },
          "notes": { "type": ["string", "null"] },
          "received_by": { "type": ["string", "null"] },
          "received_at": { "type": ["string", "null"] },
          "voided_at": { "type": ["string", "null"] },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/PurchaseItem" } }
        }
      },
      "PurchaseList": {
        "type": "object",
        "required": ["data", "total", "limit", "offset"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Purchase" } },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      },
      "CashSessionSummary": {
        "type": "object",
        "required": ["sales_count", "voided_count", "total_sales", "cash_sales", "other_sales", "cash_returns", "expected_cash"],
        "properties": {
          "sales_count": { "type": "integer", "minimum": 0 },
          "voided_count": { "type": "integer", "minimum": 0 },
          "total_sales": { "type": "string" },
          "cash_sales": { "type": "string" },
          "other_sales": { "type": "string" },
          "cash_returns": { "type": "string" },
          "expected_cash": { "type": "string" }
        }
      },
      "CashSessionDetail": {
        "type": "object",
        "required": ["id", "status", "opening_amount", "summary"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["OPEN", "CLOSED"] },
          "opened_by": { "type": ["string", "null"] },
          "opened_at": { "type": ["string", "null"] },
          "opening_amount": { "type": "string" },
          "closed_by": { "type": ["string", "null"] },
          "closed_at": { "type": ["string", "null"] },
          "counted_amount": { "type": ["string", "null"] },
          "expected_amount": { "type": ["string", "null"] },
          "difference": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "summary": { "$ref": "#/components/schemas/CashSessionSummary" }
        }
      },
      "CashSessionCurrent": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "anyOf": [
              { "$ref": "#/components/schemas/CashSessionDetail" },
              { "type": "null" }
            ]
          }
        }
      },
      "OverviewResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["summary"],
            "properties": {
              "summary": {
                "type": "object",
                "required": ["sales_count", "revenue"],
                "properties": {
                  "sales_count": { "type": "integer", "minimum": 0 },
                  "revenue": { "type": "number" }
                }
              }
            }
          },
          "unavailable": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
